WIFI_SSID=DTRDesk_Office_WiFi
WIFI_PASSWORD=replace-with-device-wifi-password
DTRDESK_API_URL=https://your-service.example/api/v1/device/logs
DTRDESK_SYNC_URL=https://your-service.example/api/v1/device/heartbeat
DTRDESK_DEVICE_ID=ESP8266_GATE_01
DTRDESK_DEVICE_KEY=replace-with-device-device-key
DTRDESK_FIRMWARE_VERSION=2.4.2

# Optional: override the self-provisioning endpoints the captive portal calls.
# config.h ships generic placeholders; uncomment to point at your service.
# DTRDESK_CLAIM_URL=https://your-service.example/api/v1/devices/claim
# DTRDESK_REGISTER_URL=https://your-service.example/api/v1/devices/register
# DTRDESK_ENROLL_RESULT_BASE=https://your-service.example/api/v1/devices
